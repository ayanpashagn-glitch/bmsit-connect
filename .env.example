# REQUIRED: replace with your PostgreSQL connection string. Keep this server-only.
DATABASE_URL=postgresql+psycopg://USERNAME:URL_ENCODED_PASSWORD@HOST:5432/DATABASE_NAME

# Session settings. Configure SMTP below before students register.
COOKIE_SECURE=false
SESSION_HOURS=24
ALLOWED_EMAIL_DOMAINS=[]

# Only when hosting publicly with HTTPS:
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://your-college-app.example
# HOST=0.0.0.0 (set as a host/container environment variable)

# REQUIRED for registration OTP email. Obtain these from your email provider/college IT.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# For implicit TLS on port 465: SMTP_PORT=465, SMTP_SSL=true, SMTP_STARTTLS=false.
# Restrict signup to actual college email domains before a college-only rollout:
# ALLOWED_EMAIL_DOMAINS=["YOUR_COLLEGE_EMAIL_DOMAIN"]

# Google Identity Services web client. This client ID is public; no client secret.
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
# Disable uploads to run a text-first pilot without an object-storage provider.
UPLOADS_ENABLED=true
STORAGE_BACKEND=local
MEDIA_ROOT=.data/covers
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for every worker in a shared deployment; blank is single-process dev only.
REDIS_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Production tuning (see PRODUCTION_CHECKLIST.md)
# AUTH_IP_LIMIT_PER_MINUTE=3000
# SMTP_TIMEOUT_SECONDS=10
# SESSION_HOURS=168
