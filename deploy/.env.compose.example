# Copy to repository .env; fill secrets locally. Use a long random hex DB password
# so the same password can be used without URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql+psycopg://bmsit:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/bmsit
CAMPUS_DOMAIN=connect.your-college.example
PUBLIC_ORIGIN=https://connect.your-college.example
COOKIE_SECURE=true
CORS_ORIGINS=[]
ALLOWED_EMAIL_DOMAINS=["YOUR_COLLEGE_EMAIL_DOMAIN"]
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Start with images disabled. Enable after configuring media quotas/backups.
UPLOADS_ENABLED=false
STORAGE_BACKEND=local
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Production tuning (added) ---
# Campus Wi-Fi often shares ONE public IP, so the per-IP ceiling must be high for a
# whole-college rollout. Per-account limits (10/min) still block password guessing.
AUTH_IP_LIMIT_PER_MINUTE=3000
SMTP_TIMEOUT_SECONDS=10
# Longer sessions mean fewer login bursts (Argon2 is CPU-heavy). Max is 168 (7 days).
SESSION_HOURS=168
