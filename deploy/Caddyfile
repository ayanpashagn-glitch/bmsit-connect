{$CAMPUS_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 3MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy app:8000
}
